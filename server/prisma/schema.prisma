generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  AUTHOR
  ADMIN
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_ON_AUTHOR
  RESOLVED
  CLOSED
}

enum TicketPriority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

model User {
  id              Int            @id @default(autoincrement())
  name            String
  email           String         @unique
  password        String
  role            UserRole       @default(AUTHOR)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  sourceAuthorId  String?        @unique
  phone           String?
  city            String?
  joinedDate      DateTime?
  books           Book[]
  tickets         Ticket[]       @relation("AuthorTickets")
  assignedTickets Ticket[]       @relation("AssignedTickets")
  messages        Message[]
  internalNotes   InternalNote[]
}

model Book {
  id                 Int       @id @default(autoincrement())
  title              String
  isbn               String?
  genre              String?
  publicationDate    DateTime?
  status             String    @default("IN PRODUCTION")
  mrp                Decimal?  @db.Decimal(10, 2)
  copiesSold         Int?
  royaltyPerCopy     Decimal?  @db.Decimal(10, 2)
  totalRoyaltyEarned Decimal?  @db.Decimal(12, 2)
  royaltyPaid        Decimal?  @db.Decimal(12, 2)
  royaltyPending     Decimal?  @db.Decimal(12, 2)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  sourceBookId          String?   @unique
  lastRoyaltyPayoutDate DateTime?
  printPartner          String?
  availableOn           String[]  @default([])

  authorId Int
  author   User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  tickets  Ticket[]
}

model Ticket {
  id                  Int            @id @default(autoincrement())
  subject             String
  description         String         @db.Text
  category            String         @default("General Inquiry")
  aiSuggestedCategory String?
  priority            TicketPriority @default(MEDIUM)

  aiSuggestedPriority TicketPriority?
  aiDraftReply        String?         @db.Text
  status              TicketStatus    @default(OPEN)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  resolvedAt          DateTime?

  authorId Int
  author   User @relation("AuthorTickets", fields: [authorId], references: [id], onDelete: Cascade)

  bookId Int?
  book   Book? @relation(fields: [bookId], references: [id], onDelete: SetNull)

  assignedAdminId Int?
  assignedAdmin   User? @relation("AssignedTickets", fields: [assignedAdminId], references: [id], onDelete: SetNull)

  messages      Message[]
  internalNotes InternalNote[]
}

model Message {
  id        Int      @id @default(autoincrement())
  content   String   @db.Text
  createdAt DateTime @default(now())

  ticketId Int
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  senderId Int
  sender   User @relation(fields: [senderId], references: [id], onDelete: Cascade)
}

model InternalNote {
  id        Int      @id @default(autoincrement())
  content   String   @db.Text
  createdAt DateTime @default(now())

  ticketId Int
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  authorId Int
  author   User @relation(fields: [authorId], references: [id], onDelete: Cascade)
}
